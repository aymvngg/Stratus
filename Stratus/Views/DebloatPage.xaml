<Page
    x:Class="Stratus.Views.DebloatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels"
    xmlns:svc="using:Stratus.Core.Services">

    <Grid Margin="32,24,32,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="3">
                <TextBlock Text="Debloat" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Remove preinstalled Store apps and launch desktop uninstallers. Store apps are removed for every user and deprovisioned."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Width="20" Height="20"
                              VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="Scan installed apps" Click="OnScan" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="{x:Bind VM.RemoveButtonText, Mode=OneWay}" Click="OnRemoveSelected"/>
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1" PlaceholderText="Search apps and publishers…" Width="320"
                 HorizontalAlignment="Left" TextChanged="OnSearchChanged"/>

        <InfoBar Grid.Row="2"
                 IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                 Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                 Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="14">

                <TextBlock Text="Run a scan to see what's installed." Style="{StaticResource PageSubtitle}"
                           Visibility="{x:Bind vm:Conv.Vis(VM.NotScannedHint), Mode=OneWay}"/>

                <!-- ============ Recommended ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind VM.RecommendedCount, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Known bloat nobody games with - news, weather, Cortana, Solitaire…"
                                           Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <HyperlinkButton Content="Select all" Click="OnSelectAllRecommended"/>
                                <HyperlinkButton Content="Clear" Click="OnClearRecommended"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nothing left in this group." Style="{StaticResource PageSubtitle}"
                                   Visibility="{x:Bind vm:Conv.Vis(VM.RecommendedEmpty), Mode=OneWay}"/>

                        <ListView ItemsSource="{x:Bind VM.Recommended, Mode=OneWay}" SelectionMode="None"
                                  ItemContainerStyle="{StaticResource FlatItem}"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:UwpRow">
                                    <Grid ColumnSpacing="10" Padding="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  Content="{x:Bind Name}" MinWidth="0"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Result, Mode=OneWay}" FontSize="10.5"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ============ Other Microsoft ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind VM.OtherMicrosoftCount, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Other Microsoft Store apps - review before removing (Phone Link, Camera, Media Player…)."
                                           Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <HyperlinkButton Content="Select all" Click="OnSelectAllOther"/>
                                <HyperlinkButton Content="Clear" Click="OnClearOther"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nothing left in this group." Style="{StaticResource PageSubtitle}"
                                   Visibility="{x:Bind vm:Conv.Vis(VM.OtherMicrosoftEmpty), Mode=OneWay}"/>

                        <ListView ItemsSource="{x:Bind VM.OtherMicrosoft, Mode=OneWay}" SelectionMode="None"
                                  ItemContainerStyle="{StaticResource FlatItem}"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:UwpRow">
                                    <Grid ColumnSpacing="10" Padding="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  Content="{x:Bind Name}" MinWidth="0"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Result, Mode=OneWay}" FontSize="10.5"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ============ Third-party ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind VM.ThirdPartyCount, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Store apps from other publishers - often driver and utility bundles."
                                           Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <HyperlinkButton Content="Select all" Click="OnSelectAllThird"/>
                                <HyperlinkButton Content="Clear" Click="OnClearThird"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nothing left in this group." Style="{StaticResource PageSubtitle}"
                                   Visibility="{x:Bind vm:Conv.Vis(VM.ThirdPartyEmpty), Mode=OneWay}"/>

                        <ListView ItemsSource="{x:Bind VM.ThirdParty, Mode=OneWay}" SelectionMode="None"
                                  ItemContainerStyle="{StaticResource FlatItem}"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:UwpRow">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="2,3">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  Content="{x:Bind Name}" MinWidth="0"/>
                                        <TextBlock Text="{x:Bind Publisher}" FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ============ Desktop programs ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{x:Bind VM.Win32Count, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Classic desktop programs - Stratus opens each program's own uninstaller."
                                       Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>

                        <TextBlock Text="No desktop programs found." Style="{StaticResource PageSubtitle}"
                                   Visibility="{x:Bind vm:Conv.Vis(VM.Win32Empty), Mode=OneWay}"/>

                        <ListView ItemsSource="{x:Bind VM.Win32, Mode=OneWay}" SelectionMode="None"
                                  ItemContainerStyle="{StaticResource FlatItem}"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:Win32AppItem">
                                    <Grid ColumnSpacing="10" Padding="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                <Run Text="{x:Bind Publisher}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{x:Bind vm:Format.Bytes(SizeBytes)}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Uninstall" Click="OnUninstallWin32"
                                                FontSize="11.5" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
