<Page
    x:Class="Stratus.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels">

    <Grid Margin="32,24,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="Tweaks" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Each toggle reads the real system state. Every change is backed up and can be reverted exactly."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="176"/>
            </Grid.ColumnDefinitions>

            <TextBox PlaceholderText="Search by name or description…"
                     TextChanged="OnSearchChanged" VerticalAlignment="Bottom"/>
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Header="Category"
                      SelectionChanged="OnCategoryChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="All categories" IsSelected="True"/>
                <ComboBoxItem Content="Gaming"/>
                <ComboBoxItem Content="Visuals"/>
                <ComboBoxItem Content="Network"/>
                <ComboBoxItem Content="Services"/>
                <ComboBoxItem Content="Privacy"/>
                <ComboBoxItem Content="Power"/>
            </ComboBox>
            <ComboBox x:Name="RiskBox" Grid.Column="2" Header="Risk"
                      SelectionChanged="OnRiskChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="All levels" IsSelected="True"/>
                <ComboBoxItem Content="Safe"/>
                <ComboBoxItem Content="Recommended"/>
                <ComboBoxItem Content="Advanced"/>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{x:Bind VM.SummaryText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="·" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="{x:Bind VM.CountText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <InfoBar Grid.Row="3"
                 IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                 Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                 Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

        <ScrollViewer Grid.Row="4" Padding="0,0,2,0">
            <StackPanel>
                <TextBlock Text="No tweaks match this filter." Margin="2,24,0,0"
                           Style="{StaticResource PageSubtitle}"
                           Visibility="{x:Bind vm:Conv.Vis(VM.NoResults), Mode=OneWay}"/>

                <ItemsControl ItemsSource="{x:Bind VM.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TweakGroup">
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,0,0,10"
                                      IsExpanded="{x:Bind HasPendingItems, Mode=OneWay}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,2">
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind Accent}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind AppliedText, Mode=OneWay}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11.5" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Grid.Column="1" Click="OnApplyCategory" Tag="{x:Bind}"
                                                IsEnabled="{x:Bind CanApplySafe, Mode=OneWay}"
                                                Content="{x:Bind PendingSafeText, Mode=OneWay}"/>
                                    </Grid>

                                    <ListView ItemsSource="{x:Bind Items}" SelectionMode="None"
                                              ItemContainerStyle="{StaticResource FlatItem}"
                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TweakItemViewModel">
                                                <Border Style="{StaticResource RowCard}">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="3" CornerRadius="2"
                                                                Background="{x:Bind Accent}"
                                                                VerticalAlignment="Stretch"/>

                                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <TextBlock Text="{x:Bind Name}" FontSize="13.5"
                                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <Border Style="{StaticResource Chip}"
                                                                        Background="{x:Bind RiskBackground}">
                                                                    <TextBlock Text="{x:Bind RiskText}"
                                                                               Style="{StaticResource ChipText}"
                                                                               Foreground="{x:Bind RiskForeground}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource CountChip}"
                                                                        Visibility="{x:Bind vm:Conv.Vis(RequiresReboot)}">
                                                                    <TextBlock Text="RESTART"
                                                                               Style="{StaticResource ChipText}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource CountChip}"
                                                                        Visibility="{x:Bind vm:Conv.Vis(NotApplicable), Mode=OneWay}">
                                                                    <TextBlock Text="N/A"
                                                                               Style="{StaticResource ChipText}"
                                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind Description}" FontSize="11.5"
                                                                       TextWrapping="Wrap" LineHeight="16"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <HyperlinkButton Content="Learn more" NavigateUri="{x:Bind DocsUrl}"
                                                                             FontSize="11" Padding="0,0,0,4" Margin="0,-4,0,0"
                                                                             HorizontalAlignment="Left"/>
                                                        </StackPanel>

                                                        <Grid Grid.Column="2" Width="46" VerticalAlignment="Center">
                                                            <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                                          Width="20" Height="20"
                                                                          HorizontalAlignment="Right"
                                                                          Visibility="{x:Bind vm:Conv.Vis(IsBusy), Mode=OneWay}"/>
                                                            <ToggleSwitch IsOn="{x:Bind IsApplied, Mode=OneWay}"
                                                                          IsEnabled="{x:Bind ToggleEnabled, Mode=OneWay}"
                                                                          OnContent="" OffContent=""
                                                                          Toggled="OnToggleToggled"
                                                                          Visibility="{x:Bind vm:Conv.NotVis(IsBusy), Mode=OneWay}"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
