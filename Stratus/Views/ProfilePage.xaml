<Page
    x:Class="Stratus.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels">

    <Grid Margin="32,24,32,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="3">
                <TextBlock Text="Profile" Style="{StaticResource PageHeader}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Width="20" Height="20"
                              VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                 Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                 Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

        <!-- ============ Save card ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel Spacing="8">
                <StackPanel Spacing="1">
                    <TextBlock Text="Save this setup" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Writes every selection Stratus knows about into one JSON file: applied tweaks, disabled startup entries and tasks, enabled Windows features, installed catalog apps, cleanup targets, DNS, power plan and TCP settings."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Button Content="Save profile" Style="{StaticResource AccentButtonStyle}" Click="OnExport"
                        IsEnabled="{x:Bind VM.CanInteract, Mode=OneWay}"/>

                <TextBlock Text="{x:Bind VM.ExportPath, Mode=OneWay}"
                           Visibility="{x:Bind vm:Conv.Vis(VM.HasExportPath), Mode=OneWay}"
                           IsTextSelectionEnabled="True" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ============ Load card ============ -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel Spacing="8">
                <StackPanel Spacing="1">
                    <TextBlock Text="Load a setup" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Importing only adds. It applies missing tweaks, disables the listed entries, enables the listed features and installs the listed apps. It never reverts, re-enables or uninstalls anything."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox PlaceholderText="Path to a profile JSON" Width="360"
                             Text="{x:Bind VM.ProfilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Browse" Click="OnBrowse"/>
                    <Button Grid.Column="2" Content="Import" Click="OnImport"
                            IsEnabled="{x:Bind VM.CanInteract, Mode=OneWay}"/>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="4">
            <StackPanel Spacing="14">
                <!-- ============ Preview card ============ -->
                <Border Style="{StaticResource Card}"
                        Visibility="{x:Bind vm:Conv.Vis(VM.HasPreview), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind VM.PreviewTitle, Mode=OneWay}" Style="{StaticResource CardTitle}"/>

                        <ListView ItemsSource="{x:Bind VM.Preview, Mode=OneWay}" SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ItemContainerStyle="{StaticResource FlatItem}"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfileRow">
                                    <Grid ColumnSpacing="10" Padding="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind Category}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13.5"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ActionText}" FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind ChangeText}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="{x:Bind VM.SummaryText, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                                   Visibility="{x:Bind vm:Conv.Vis(VM.HasSummary), Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply profile" Style="{StaticResource AccentButtonStyle}" Click="OnApply"
                                    IsEnabled="{x:Bind VM.CanApply, Mode=OneWay}"/>
                            <Button Content="Cancel" Click="OnCancel"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="No profile loaded yet." Style="{StaticResource PageSubtitle}"
                           Visibility="{x:Bind vm:Conv.NotVis(VM.HasPreview), Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
