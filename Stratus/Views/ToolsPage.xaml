                        <Button Grid.Row="2" Grid.Column="1" Content="Services" Tag="services.msc" Click="OnOpenWindowsTool"
                                HorizontalAlignment="Stretch" FontSize="11.5"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>

                        <Button Grid.Row="3" Content="Task scheduler" Tag="taskschd.msc" Click="OnOpenWindowsTool"
