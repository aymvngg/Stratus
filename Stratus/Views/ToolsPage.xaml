<Page
    x:Class="Stratus.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels"
    xmlns:svc="using:Stratus.Core.Services">

    <Grid Margin="32,24,32,32">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
            <StackPanel Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">

                <StackPanel Spacing="4">
                    <TextBlock Text="Tools" Style="{StaticResource PageHeader}"/>
                    <TextBlock Text="System repairs, resets, network diagnostics and classic Windows tools."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <InfoBar IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                         IsClosable="True"
                         Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                         Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

                <TextBlock Text="Repair" Style="{StaticResource SectionHeader}"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Glyph="&#xE9D9;" Style="{StaticResource BadgeGlyph}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Health scan" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="The same tools Windows uses" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="SFC checks protected system files. DISM checks and repairs the component store that SFC restores from. Component store cleanup removes superseded versions of Windows components. Long jobs, keep the machine plugged in."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Scan system files (SFC)" Click="OnSfc"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <Button Content="Scan component store" Click="OnDismScan"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <Button Content="Repair component store" Click="OnDismRestore"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <Button Content="Component store cleanup" Click="OnComponentCleanup"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}"
                                          Width="18" Height="18"
                                          Visibility="{x:Bind vm:Conv.Vis(VM.IsBusy), Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Border Padding="14,12" CornerRadius="6"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                Visibility="{x:Bind vm:Conv.Vis(VM.HasScan), Mode=OneWay}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind VM.ScanTitle, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind VM.ScanSummary, Mode=OneWay}"
                                           FontSize="12" TextWrapping="Wrap"/>
                                <Expander HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBlock Text="Show raw output" FontSize="12.5"/>
                                    </Expander.Header>
                                    <TextBox Text="{x:Bind VM.ScanDetail, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="NoWrap" Height="220"
                                             AcceptsReturn="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="11" BorderThickness="0"
                                             Background="Transparent"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Reset" Style="{StaticResource SectionHeader}"/>

                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" BorderBrush="#66FFB900">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource IconBadge}" Background="#33FFB900">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="#FFE9A825"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Windows update reset" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Stuck updates, endless retries" Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Stratus stops the update services, moves SoftwareDistribution and catroot2 aside, then restarts the services. Windows rebuilds both folders on the next update check. Nothing is deleted: the old folders stay on disk with a timestamp."
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Reset update cache" Click="OnResetWindowsUpdate"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" BorderBrush="#66FFB900">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource IconBadge}" Background="#33FFB900">
                                    <FontIcon Glyph="&#xE968;" FontSize="16" Foreground="#FFE9A825"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Network reset" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Broken stack after VPN or proxy" Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Resets winsock, the TCP/IP stack and the DNS cache, then re-registers DNS. Use it when connections fail while other devices on the network work. Restart afterwards. Static IP settings and VPN adapters can be affected."
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Reset network stack" Click="OnResetNetwork"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Network" Style="{StaticResource SectionHeader}"/>

                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource IconBadge}">
                                    <FontIcon Glyph="&#xE774;" Style="{StaticResource BadgeGlyph}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="DNS resolver" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Latency and privacy" Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Fast, privacy-respecting resolvers usually beat ISP defaults. Applied to every connected physical adapter."
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox MinWidth="200" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind VM.DnsProfiles, Mode=OneWay}"
                                      SelectedItem="{x:Bind VM.SelectedDns, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="svc:DnsProfile">
                                        <TextBlock Text="{x:Bind Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Apply DNS" Click="OnApplyDns"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                                <TextBlock VerticalAlignment="Center" FontSize="11">
                                    <Run Text="Active: " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <Run Text="{x:Bind VM.CurrentDnsLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                <Run Text="Adapters affected: "/><Run Text="{x:Bind VM.AdaptersText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource IconBadge}">
                                    <FontIcon Glyph="&#xE968;" Style="{StaticResource BadgeGlyph}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="TCP settings" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Current value next to the Windows default" Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Read from the registry, applied through netsh. Pick a value and apply; reset all puts every row back to the default shown beside it."
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind VM.TcpSettings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TcpRow">
                                        <Grid Padding="0,5" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock FontSize="10"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="Now: "/><Run Text="{x:Bind CurrentText, Mode=OneWay}"/>
                                                    <Run Text="   "/><Run Text="{x:Bind DefaultText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" MinWidth="130"
                                                      ItemsSource="{x:Bind Values, Mode=OneWay}"
                                                      SelectedItem="{x:Bind SelectedValue, Mode=TwoWay}"
                                                      VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="Apply" Click="OnApplyTcp"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{x:Bind CanInteract, Mode=OneWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Reset all to defaults" Click="OnResetTcp"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Glyph="&#xE774;" Style="{StaticResource BadgeGlyph}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="DNS benchmark" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Real latency, measured here" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Sends live DNS queries straight to each public resolver, three times each, and averages the round trip. Bypasses the Windows cache, so the numbers are what a new lookup would cost."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Benchmark resolvers" Click="OnBenchmarkDns"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}"
                                          Width="18" Height="18"
                                          Visibility="{x:Bind vm:Conv.Vis(VM.IsBusy), Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind VM.DnsResults, Mode=OneWay}"
                                  SelectionMode="None" IsItemClickEnabled="False"
                                  Style="{StaticResource FlatItem}"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  Visibility="{x:Bind vm:Conv.Vis(VM.HasDnsResults), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:DnsBenchmarkResult">
                                    <Grid Padding="2,5" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Server}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind LatencyText}" FontSize="12.5"
                                                   FontWeight="SemiBold" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <TextBlock Text="Maintenance" Style="{StaticResource SectionHeader}"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Glyph="&#xE777;" Style="{StaticResource BadgeGlyph}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Restore points" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{x:Bind VM.RestoreStorageText, Mode=OneWay}"
                                           Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <Button Content="Create point" Click="OnRestorePoint"
                                        IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                                <Button Content="Refresh" Click="OnRefreshRestorePoints"
                                        IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Each row is one snapshot Windows can roll back to. Deleting a point only removes that snapshot; newer points and your files are untouched."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind VM.RestoreEmptyText, Mode=OneWay}" FontSize="12"
                                   Visibility="{x:Bind vm:Conv.NotVis(VM.HasRestorePoints), Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ListView ItemsSource="{x:Bind VM.RestorePoints, Mode=OneWay}"
                                  SelectionMode="None" IsItemClickEnabled="False"
                                  Style="{StaticResource FlatItem}"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  Visibility="{x:Bind vm:Conv.Vis(VM.HasRestorePoints), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RestorePointRow">
                                    <Grid Padding="2,5" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Description}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind MetaText}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Delete" Click="OnDeleteRestorePoint"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource IconBadge}">
                                    <FontIcon Glyph="&#xE945;" Style="{StaticResource BadgeGlyph}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Power plan" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="CPU/GPU scheduling policy" Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Ultimate Performance removes CPU parking and display sleep timers. Balanced is the battery-friendly default."
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="PlanBox" MinWidth="200" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{x:Bind VM.Plans, Mode=OneWay}"
                                      SelectedItem="{x:Bind VM.SelectedPlan, Mode=TwoWay}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Activate" Click="OnApplyPlan"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                                <Button Content="Refresh" Click="OnReload"
                                        IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            </StackPanel>
                            <TextBlock FontSize="11">
                                <Run Text="Active: " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <Run Text="{x:Bind VM.ActivePlanText, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource IconBadge}">
                                    <FontIcon Glyph="&#xE823;" Style="{StaticResource BadgeGlyph}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Update pause" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{x:Bind VM.UpdatePauseText, Mode=OneWay}"
                                               Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{x:Bind VM.UpdatePauseHint, Mode=OneWay}"
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="{x:Bind VM.UpdatePauseButtonText, Mode=OneWay}"
                                    Click="OnToggleUpdatePause"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Glyph="&#xE90F;" Style="{StaticResource BadgeGlyph}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="System report" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Machine snapshot for bug reports" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Collects Windows version, hardware summary, active tweaks and recent history into one text file you can attach to an issue."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="System report" Click="OnCreateReport"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}"
                                          Width="18" Height="18"
                                          Visibility="{x:Bind vm:Conv.Vis(VM.IsBusy), Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Fixes" Style="{StaticResource SectionHeader}"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Glyph="&#xE90F;" Style="{StaticResource BadgeGlyph}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Common fixes" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Small repairs, one click each" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="One-click repairs for common Windows problems. These change system settings, not Stratus tweaks. Repair winget needs App Installer (winget) from the Microsoft Store."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Use pool.ntp.org" Click="OnFixNtp"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <Button Content="Restore Windows time server" Click="OnRestoreNtp"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <Button Content="Repair winget" Click="OnRepairWinget"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Windows tools" Style="{StaticResource SectionHeader}"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Glyph="&#xE7F8;" Style="{StaticResource BadgeGlyph}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Classic management consoles" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Open the classic Windows management consoles without hunting through menus."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Content="Computer management" Tag="compmgmt.msc" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="Installed apps" Tag="appwiz.cpl" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="Network adapters" Tag="ncpa.cpl" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Power options" Tag="powercfg.cpl" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="Device manager" Tag="devmgmt.msc" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Services" Tag="services.msc" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="Task scheduler" Tag="taskschd.msc" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="Windows Features" Tag="optionalfeatures.exe" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="4" Grid.Column="0" Content="Firewall" Tag="firewall.cpl" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="4" Grid.Column="1" Content="System properties" Tag="sysdm.cpl" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="5" Grid.Column="0" Content="Disk management" Tag="diskmgmt.msc" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
                            <Button Grid.Row="5" Grid.Column="1" Content="Event viewer" Tag="eventvwr.msc" Click="OnOpenWindowsTool" HorizontalAlignment="Stretch" FontSize="11.5"/>
