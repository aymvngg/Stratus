<Page
    x:Class="Stratus.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels"
    xmlns:svc="using:Stratus.Core.Services">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="14">

            <StackPanel Spacing="3">
                <TextBlock Text="Tools" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="System actions that aren't registry tweaks - power plans, DNS, restore points and Stratus data."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ Power plan ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE945;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Power plan" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="CPU/GPU scheduling policy" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Ultimate Performance removes CPU parking and display sleep timers. Balanced is the battery-friendly default."/>

                        <ComboBox x:Name="PlanBox" DisplayMemberPath="Name" MinWidth="200"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind VM.Plans, Mode=OneWay}"
                                  SelectedItem="{x:Bind VM.SelectedPlan, Mode=TwoWay}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Activate" Click="OnApplyPlan" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Refresh" Click="OnReload"/>
                        </StackPanel>

                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Active: "/><Run Text="{x:Bind VM.ActivePlanText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ============ DNS ============ -->
                <Border Style="{StaticResource Card}" Grid.Column="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE774;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="DNS resolver" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Latency and privacy" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Fast, privacy-respecting resolvers usually beat ISP defaults. Applied to every connected physical adapter."/>

                        <ComboBox MinWidth="200" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind VM.DnsProfiles, Mode=OneWay}"
                                  SelectedItem="{x:Bind VM.SelectedDns, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:DnsProfile">
                                    <TextBlock Text="{x:Bind Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="Apply DNS" Click="OnApplyDns" Style="{StaticResource AccentButtonStyle}"/>

                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Adapters affected: "/><Run Text="{x:Bind VM.AdaptersText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ============ Maintenance ============ -->
                <Border Style="{StaticResource Card}" Grid.Row="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE90F;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Maintenance" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Safety net and data" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Create a System Restore point before big changes. Backups of every registry value Stratus touched live in ProgramData."/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Create restore point" Click="OnRestorePoint"/>
                            <Button Content="System report" Click="OnCreateReport"/>
                            <Button Content="Open data folder" Click="OnOpenFolder"/>
                            <Button Content="Open logs" Click="OnOpenLogs"/>
                            <Button Content="Component store cleanup" Click="OnComponentCleanup"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Width="18" Height="18"
                                          VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Reset ============ -->
                <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="1"
                        BorderBrush="#66C42B1C">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}" Background="#33C42B1C">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE7BA;" Foreground="#FFF48B8B"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Reset" Style="{StaticResource CardTitle}" Foreground="#FFF48B8B"/>
                                <TextBlock Text="Revert everything" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Reverts every tweak detected as applied - including changes made by hand or by other tools - using the exact values backed up at change time."/>

                        <Button Content="Revert all tweaks" Click="OnRevertAll"
                                Background="#66C42B1C" Foreground="#FFF48B8B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Health scan ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource IconBadge}">
                            <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE9D9;"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Health scan" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="The same tools Windows uses" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="SFC checks protected system files. DISM checks and repairs the component store that SFC restores from. Long jobs, keep the machine plugged in."/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Scan system files (SFC)" Click="OnSfc" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Scan component store" Click="OnDismScan"/>
                        <Button Content="Repair component store" Click="OnDismRestore"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Width="18" Height="18"
                                      VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Border Padding="14,12" CornerRadius="6"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Visibility="{x:Bind vm:Conv.Vis(VM.HasScan), Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind VM.ScanTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind VM.ScanSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                            <Expander Header="Show raw output" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <TextBox Text="{x:Bind VM.ScanDetail, Mode=OneWay}" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas" FontSize="11" Height="220"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ Resets + DNS benchmark ============ -->
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" BorderBrush="#66FFB900">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}" Background="#33FFB900">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE896;" Foreground="#FFE9A825"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Windows Update reset" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Stuck updates, endless retries" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Stops the update services, moves the download cache and the cryptography catalogue aside, then restarts them. Windows rebuilds both on the next check. Nothing is deleted: the old folders are kept with a timestamp."/>

                        <Button Content="Reset update cache" Click="OnResetWindowsUpdate"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1" BorderBrush="#66FFB900">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}" Background="#33FFB900">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE968;" Foreground="#FFE9A825"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Network reset" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Broken stack after VPN or proxy" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Resets winsock, the TCP/IP stack and the DNS cache, then re-registers DNS. Use it when connections fail while other devices on the network work. Restart afterwards."/>

                        <Button Content="Reset network stack" Click="OnResetNetwork"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="1" Grid.ColumnSpan="2">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE774;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="DNS benchmark" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Real latency, measured here" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Sends live DNS queries straight to each public resolver, three times each, and averages the round trip. Bypasses the Windows cache, so the numbers are what a new lookup would cost."/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Benchmark resolvers" Click="OnBenchmarkDns"/>
                            <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ListView ItemsSource="{x:Bind VM.DnsResults, Mode=OneWay}" SelectionMode="None"
                                  ItemContainerStyle="{StaticResource FlatItem}"
                                  Visibility="{x:Bind vm:Conv.Vis(VM.HasDnsResults), Mode=OneWay}"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:DnsBenchmarkResult">
                                    <Grid ColumnSpacing="12" Padding="2,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Server}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind LatencyText}" FontSize="12.5"
                                                   FontWeight="SemiBold" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Preferences ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource IconBadge}">
                            <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE713;"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Preferences" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Appearance and background behaviour" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Theme" VerticalAlignment="Center" Style="{StaticResource SummaryValue}"/>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="Follow system"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                        </ComboBox>

                        <ToggleSwitch x:Name="TrayToggle" Grid.Row="1" Grid.ColumnSpan="2"
                                      Header="Keep running in the tray when closed"
                                      OnContent="On" OffContent="Off"
                                      Toggled="OnTrayToggled"/>
                    </Grid>

                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="With tray mode on, closing the window hides Stratus in the notification area and the score keeps tracking. Use Exit in the tray menu to quit."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
