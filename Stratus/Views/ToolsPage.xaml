<Page
    x:Class="Stratus.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels"
    xmlns:svc="using:Stratus.Core.Services">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="14">

            <StackPanel Spacing="3">
                <TextBlock Text="Tools" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="System actions that aren't registry tweaks - power plans, DNS, restore points and Stratus data."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ Power plan ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE945;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Power plan" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="CPU/GPU scheduling policy" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Ultimate Performance removes CPU parking and display sleep timers. Balanced is the battery-friendly default."/>

                        <ComboBox x:Name="PlanBox" DisplayMemberPath="Name" MinWidth="200"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind VM.Plans, Mode=OneWay}"
                                  SelectedItem="{x:Bind VM.SelectedPlan, Mode=TwoWay}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Activate" Click="OnApplyPlan" Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <Button Content="Refresh" Click="OnReload"/>
                        </StackPanel>

                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Active: "/><Run Text="{x:Bind VM.ActivePlanText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ============ DNS ============ -->
                <Border Style="{StaticResource Card}" Grid.Column="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE774;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="DNS resolver" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Latency and privacy" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Fast, privacy-respecting resolvers usually beat ISP defaults. Applied to every connected physical adapter."/>

                        <ComboBox MinWidth="200" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind VM.DnsProfiles, Mode=OneWay}"
                                  SelectedItem="{x:Bind VM.SelectedDns, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:DnsProfile">
                                    <TextBlock Text="{x:Bind Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="Apply DNS" Click="OnApplyDns" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>

                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Active: "/><Run Text="{x:Bind VM.CurrentDnsLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>

                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Adapters affected: "/><Run Text="{x:Bind VM.AdaptersText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ============ Maintenance ============ -->
                <Border Style="{StaticResource Card}" Grid.Row="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE90F;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Maintenance" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Safety net and data" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Create a System Restore point before big changes. Backups of every registry value Stratus touched live in ProgramData."/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Create restore point" Click="OnRestorePoint"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <Button Content="System report" Click="OnCreateReport"/>
                            <Button Content="Open data folder" Click="OnOpenFolder"/>
                            <Button Content="Open logs" Click="OnOpenLogs"/>
                            <Button Content="Component store cleanup" Click="OnComponentCleanup"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Width="18" Height="18"
                                          VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Reset ============ -->
                <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="1"
                        BorderBrush="#66C42B1C">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}" Background="#33C42B1C">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE7BA;" Foreground="#FFF48B8B"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Reset" Style="{StaticResource CardTitle}" Foreground="#FFF48B8B"/>
                                <TextBlock Text="Revert everything" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Reverts every tweak detected as applied - including changes made by hand or by other tools - using the exact values backed up at change time."/>

                        <Button Content="Revert all tweaks" Click="OnRevertAll"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"
                                Background="#66C42B1C" Foreground="#FFF48B8B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Health scan ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource IconBadge}">
                            <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE9D9;"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Health scan" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="The same tools Windows uses" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="SFC checks protected system files. DISM checks and repairs the component store that SFC restores from. Long jobs, keep the machine plugged in."/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Scan system files (SFC)" Click="OnSfc" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        <Button Content="Scan component store" Click="OnDismScan"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        <Button Content="Repair component store" Click="OnDismRestore"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Width="18" Height="18"
                                      VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Border Padding="14,12" CornerRadius="6"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Visibility="{x:Bind vm:Conv.Vis(VM.HasScan), Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind VM.ScanTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind VM.ScanSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                            <Expander Header="Show raw output" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <TextBox Text="{x:Bind VM.ScanDetail, Mode=OneWay}" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas" FontSize="11" Height="220"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ Resets + DNS benchmark ============ -->
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" BorderBrush="#66FFB900">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}" Background="#33FFB900">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE896;" Foreground="#FFE9A825"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Windows Update reset" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Stuck updates, endless retries" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Stops the update services, moves the download cache and the cryptography catalogue aside, then restarts them. Windows rebuilds both on the next check. Nothing is deleted: the old folders are kept with a timestamp."/>

                        <Button Content="Reset update cache" Click="OnResetWindowsUpdate"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1" BorderBrush="#66FFB900">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}" Background="#33FFB900">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE968;" Foreground="#FFE9A825"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Network reset" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Broken stack after VPN or proxy" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Resets winsock, the TCP/IP stack and the DNS cache, then re-registers DNS. Use it when connections fail while other devices on the network work. Restart afterwards."/>

                        <Button Content="Reset network stack" Click="OnResetNetwork"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="1" Grid.ColumnSpan="2">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE774;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="DNS benchmark" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Real latency, measured here" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Sends live DNS queries straight to each public resolver, three times each, and averages the round trip. Bypasses the Windows cache, so the numbers are what a new lookup would cost."/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Benchmark resolvers" Click="OnBenchmarkDns"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ListView ItemsSource="{x:Bind VM.DnsResults, Mode=OneWay}" SelectionMode="None"
                                  ItemContainerStyle="{StaticResource FlatItem}"
                                  Visibility="{x:Bind vm:Conv.Vis(VM.HasDnsResults), Mode=OneWay}"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:DnsBenchmarkResult">
                                    <Grid ColumnSpacing="12" Padding="2,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Server}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind LatencyText}" FontSize="12.5"
                                                   FontWeight="SemiBold" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Restore points ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconBadge}">
                            <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE777;"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Restore points" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{x:Bind VM.RestoreStorageText, Mode=OneWay}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Create point" Click="OnRestorePoint"
                                    IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                            <Button Content="Refresh" Click="OnRefreshRestorePoints"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Each row is one snapshot Windows can roll back to. Deleting a point only removes that snapshot; newer points and your files are untouched."/>

                    <TextBlock Text="{x:Bind VM.RestoreEmptyText, Mode=OneWay}"
                               Style="{StaticResource PageSubtitle}"
                               Visibility="{x:Bind vm:Conv.NotVis(VM.HasRestorePoints), Mode=OneWay}"/>

                    <ListView ItemsSource="{x:Bind VM.RestorePoints, Mode=OneWay}" SelectionMode="None"
                              ItemContainerStyle="{StaticResource FlatItem}"
                              Visibility="{x:Bind vm:Conv.Vis(VM.HasRestorePoints), Mode=OneWay}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RestorePointRow">
                                <Grid ColumnSpacing="12" Padding="2,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Description}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind MetaText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Delete" Click="OnDeleteRestorePoint"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- ============ Update pause + TCP ============ -->
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE823;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Update pause" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{x:Bind VM.UpdatePauseText, Mode=OneWay}" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{x:Bind VM.UpdatePauseHint, Mode=OneWay}"
                                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>

                        <Button Content="{x:Bind VM.UpdatePauseButtonText, Mode=OneWay}"
                                Click="OnToggleUpdatePause"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE968;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="TCP settings" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Current value next to the Windows default" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                   Text="Read from the registry, applied through netsh. Pick a value and apply; reset all puts every row back to the default shown beside it."/>

                        <ItemsControl ItemsSource="{x:Bind VM.TcpSettings, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TcpRow">
                                    <Grid ColumnSpacing="8" Padding="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                <Run Text="Now: "/><Run Text="{x:Bind CurrentText}"/>
                                                <Run Text="   "/><Run Text="{x:Bind DefaultText}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                                  ItemsSource="{x:Bind Values}"
                                                  SelectedItem="{x:Bind SelectedValue, Mode=TwoWay}"/>
                                        <Button Grid.Column="2" Content="Apply" Click="OnApplyTcp"
                                                VerticalAlignment="Center"
                                                IsEnabled="{x:Bind CanInteract, Mode=OneWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Reset all to defaults" Click="OnResetTcp"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Updates ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconBadge}">
                            <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE895;"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Updates" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{x:Bind VM.CurrentVersionText, Mode=OneWay}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>

                        <Button Grid.Column="2" VerticalAlignment="Center"
                                Content="{x:Bind VM.UpdateButtonText, Mode=OneWay}"
                                Click="OnUpdateAction"
                                IsEnabled="{x:Bind VM.CanCheckForUpdates, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </Grid>

                    <TextBlock Text="{x:Bind VM.UpdateStatusText, Mode=OneWay}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap"/>

                    <ProgressBar Value="{x:Bind VM.UpdateProgress, Mode=OneWay}" Maximum="100" Height="4"
                                 Visibility="{x:Bind vm:Conv.Vis(VM.IsDownloading), Mode=OneWay}"/>

                    <Expander Header="What's new" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind vm:Conv.Vis(VM.HasUpdateNotes), Mode=OneWay}">
                        <TextBox Text="{x:Bind VM.UpdateNotesText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="160" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Expander>

                    <ToggleSwitch Header="Check for updates automatically" OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind VM.AutoCheck, Mode=TwoWay}"/>
                    <TextBlock Text="{x:Bind VM.AutoCheckHint, Mode=OneWay}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Border>

            <!-- ============ Fixes ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource IconBadge}">
                            <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE90F;"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Fixes" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Common Windows repairs" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="One-click repairs for common Windows problems. These change system settings, not Stratus tweaks."/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Use pool.ntp.org" Click="OnFixNtp"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        <Button Content="Restore Windows time server" Click="OnRestoreNtp"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        <Button Content="Repair winget" Click="OnRepairWinget"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                    </StackPanel>

                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Repair winget needs App Installer (winget) from the Microsoft Store."/>
                </StackPanel>
            </Border>

            <!-- ============ Windows tools ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource IconBadge}">
                            <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE7F8;"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Windows tools" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Classic management consoles" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Open the classic Windows management consoles without hunting through menus."/>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Content="Computer management" Tag="compmgmt.msc" Click="OnOpenWindowsTool"
                                HorizontalAlignment="Stretch" FontSize="11.5"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        <Button Grid.Column="1" Content="Installed apps" Tag="appwiz.cpl" Click="OnOpenWindowsTool"
                                HorizontalAlignment="Stretch" FontSize="11.5"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>

                        <Button Grid.Row="1" Content="Network adapters" Tag="ncpa.cpl" Click="OnOpenWindowsTool"
                                HorizontalAlignment="Stretch" FontSize="11.5"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
