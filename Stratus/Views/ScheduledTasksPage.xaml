<Page
    x:Class="Stratus.Views.ScheduledTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="14">

            <StackPanel Spacing="3">
                <TextBlock Text="Scheduled tasks" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Background tasks Windows runs on a timer. These are the telemetry, inventory and feedback jobs that do nothing for you. Turning one off keeps the task, it only stops it from running."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource IconBadge}">
                                <FontIcon Style="{StaticResource BadgeGlyph}" Glyph="&#xE823;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Telemetry and inventory tasks" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{x:Bind VM.CountText, Mode=OneWay}" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Reset changes" Click="OnResetAll"/>
                            <Button Content="Refresh" Click="OnRefresh"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox PlaceholderText="Search tasks…" Width="200" TextChanged="OnSearchChanged"/>
                        <ComboBox MinWidth="190"
                                  ItemsSource="{x:Bind VM.Folders, Mode=OneWay}"
                                  SelectedItem="{x:Bind VM.FolderFilter, Mode=TwoWay}"/>
                        <Button Content="Presets">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Disable telemetry tasks" Tag="Telemetry" Click="OnPresetDisable"/>
                                    <MenuFlyoutItem Text="Disable feedback tasks" Tag="Feedback" Click="OnPresetDisable"/>
                                    <MenuFlyoutItem Text="Disable appraiser tasks" Tag="Compatibility" Click="OnPresetDisable"/>
                                    <MenuFlyoutItem Text="Disable diagnostic tasks" Tag="Diagnostics" Click="OnPresetDisable"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Enable telemetry tasks" Tag="Telemetry" Click="OnPresetEnable"/>
                                    <MenuFlyoutItem Text="Enable feedback tasks" Tag="Feedback" Click="OnPresetEnable"/>
                                    <MenuFlyoutItem Text="Enable appraiser tasks" Tag="Compatibility" Click="OnPresetEnable"/>
                                    <MenuFlyoutItem Text="Enable diagnostic tasks" Tag="Diagnostics" Click="OnPresetEnable"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="Select all" Click="OnSelectAll"/>
                        <Button Content="None" Click="OnSelectNone"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind vm:Conv.Vis(VM.HasChecked), Mode=OneWay}">
                        <TextBlock Text="{x:Bind VM.SelectionText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource PageSubtitle}"/>
                        <Button Content="Enable selected" Click="OnEnableChecked"/>
                        <Button Content="Disable selected" Click="OnDisableChecked"/>
                    </StackPanel>

                    <TextBlock Text="{x:Bind VM.EmptyText, Mode=OneWay}"
                               Style="{StaticResource PageSubtitle}"
                               Visibility="{x:Bind vm:Conv.Vis(VM.Empty), Mode=OneWay}"/>

                    <ItemsControl ItemsSource="{x:Bind VM.Filtered, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScheduledTaskRow">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{x:Bind IsChecked, Mode=TwoWay}"/>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Chip}">
                                                    <TextBlock Text="{x:Bind GroupText}" Style="{StaticResource ChipText}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}"
                                                       FontSize="11"
                                                       MaxLines="2"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind FolderText}"
                                                       FontSize="10"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                <Run Text="Last run: "/><Run Text="{x:Bind LastRunText}"/>
                                                <Run Text="  Next: "/><Run Text="{x:Bind NextRunText}"/>
                                                <Run Text="  By: "/><Run Text="{x:Bind AuthorText}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                                      IsEnabled="{x:Bind ToggleEnabled, Mode=OneWay}"
                                                      Toggled="OnToggle"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
