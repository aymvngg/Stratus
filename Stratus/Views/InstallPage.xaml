<Page
    x:Class="Stratus.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels">

    <Grid Margin="32,24,32,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="3">
                <TextBlock Text="Install" Style="{StaticResource PageHeader}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Width="20" Height="20"
                              VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                 Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                 Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

        <!-- ============ Header card ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel Spacing="8">
                <StackPanel Spacing="1">
                    <TextBlock Text="Install apps" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Install, upgrade and remove apps through winget. Nothing is downloaded until you pick an app."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind VM.WingetText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh" Click="OnRefresh"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                        <Button Content="Upgrade installed" Click="OnUpgradeAll"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind vm:Conv.Not(VM.IsBusy), Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Install App Installer from the Microsoft Store to use this page."
                           Style="{StaticResource PageSubtitle}"
                           Visibility="{x:Bind vm:Conv.Vis(VM.WingetMissing), Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- ============ Filter row ============ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
            <TextBox PlaceholderText="Search apps" Width="280" TextChanged="OnSearchTextChanged"/>
            <ComboBox ItemsSource="{x:Bind VM.Categories, Mode=OneWay}"
                      SelectedItem="{x:Bind VM.SelectedCategory, Mode=TwoWay}"
                      Width="200"/>
            <TextBlock Text="{x:Bind VM.CountText, Mode=OneWay}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="4">
            <StackPanel Spacing="14">
                <ListView ItemsSource="{x:Bind VM.FilteredGroups, Mode=OneWay}" SelectionMode="None"
                          ItemContainerStyle="{StaticResource FlatItem}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstallGroup">
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                                      Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,2">
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <Border Style="{StaticResource CountChip}">
                                            <TextBlock Text="{x:Bind CountText}" Style="{StaticResource ChipText}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <ListView ItemsSource="{x:Bind Rows, Mode=OneWay}" SelectionMode="None"
                                          ItemContainerStyle="{StaticResource FlatItem}"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InstallRow">
                                            <Grid ColumnSpacing="12" Padding="2,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Image Source="{x:Bind IconSource, Mode=OneWay}"
                                                               Width="20" Height="20"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{x:Bind vm:Conv.Vis(HasIcon), Mode=OneWay}"/>
                                                        <Border CornerRadius="5"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{x:Bind vm:Conv.NotVis(HasIcon), Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind IconLetter}" FontSize="13"
                                                                       FontWeight="SemiBold" Margin="6,2"
                                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold"/>
                                                        <Border Style="{StaticResource CountChip}"
                                                                Visibility="{x:Bind vm:Conv.Vis(Recommended)}">
                                                            <TextBlock Text="Recommended" Style="{StaticResource ChipText}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="10.5"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11.5" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="11.5"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               Visibility="{x:Bind vm:Conv.Vis(HasStatus), Mode=OneWay}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Content="{x:Bind ActionText, Mode=OneWay}"
                                                            Click="OnInstall"
                                                            FontSize="11.5"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            IsEnabled="{x:Bind CanAct, Mode=OneWay}"/>
                                                    <Button Content="Remove"
                                                            Click="OnUninstall"
                                                            FontSize="11.5"
                                                            IsEnabled="{x:Bind CanUninstall, Mode=OneWay}"
                                                            Visibility="{x:Bind vm:Conv.Vis(CanUninstall), Mode=OneWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="No apps match this filter." Style="{StaticResource PageSubtitle}"
                           Visibility="{x:Bind vm:Conv.Vis(VM.IsEmpty), Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
