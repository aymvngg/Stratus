<Page
    x:Class="Stratus.Views.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stratus.ViewModels">

    <Grid Margin="32,24,32,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="3">
                <TextBlock Text="Cleanup" Style="{StaticResource PageHeader}"/>
                <TextBlock Text="Temp files, shader caches, error reports and update leftovers. Locked files are skipped, never forced."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Width="20" Height="20"
                              VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind VM.BusyText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="Scan" Click="OnScan" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind VM.StatusOpen, Mode=TwoWay}"
                 Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                 Severity="{x:Bind VM.StatusSeverity, Mode=OneWay}"/>

        <!-- Reclaimable summary -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22,18">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="RECLAIMABLE NOW" Style="{StaticResource StatLabel}" CharacterSpacing="60"/>
                    <TextBlock Text="{x:Bind VM.SelectedText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold"
                               CharacterSpacing="-15"/>
                    <TextBlock Text="{x:Bind VM.AllText, Mode=OneWay}" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource CountChip}" Padding="8,3" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Visibility="{x:Bind vm:Conv.Vis(VM.HasSession), Mode=OneWay}">
                        <TextBlock Text="{x:Bind VM.SessionText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <CheckBox Content="Also empty the Recycle Bin"
                              Checked="OnRecycleChanged" Unchecked="OnRecycleChanged"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind VM.CleanButtonText, Mode=OneWay}" Click="OnClean"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Select all" Click="OnSelectAll"/>
                        <Button Content="Recommended" Click="OnSelectRecommended"/>
                        <Button Content="None" Click="OnSelectNone"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3">
            <StackPanel>
                <TextBlock Text="Run a scan to measure each location." Margin="2,12,0,0"
                           Style="{StaticResource PageSubtitle}"
                           Visibility="{x:Bind vm:Conv.Vis(VM.NotScannedHint), Mode=OneWay}"/>

                <ItemsControl ItemsSource="{x:Bind VM.Rows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CleanupRow">
                            <Border Style="{StaticResource RowCard}" Padding="14,11">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                              MinWidth="0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind PathText}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Opacity="{x:Bind SizeOpacity, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
